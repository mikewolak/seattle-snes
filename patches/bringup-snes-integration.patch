diff -ruN a/bringup/Makefile b/bringup/Makefile
--- a/bringup/Makefile	2026-11-09 21:26:24
+++ b/bringup/Makefile	2026-11-09 21:26:41
@@ -171,6 +171,42 @@
 	@mkdir -p $(dir $@)
 	cp "$(NESROM)" $@
 
+# ---- SNES (disk build only): Snes9x 1.39 core (Gary Henderson, Jerremy
+# Koot et al.; non-commercial licence, ../docs/SNES.md), the C++ core files of
+# the release source s9xs139.zip with patches/snes9x-1.39-seattle.patch
+# applied, and the Seattle platform layer snes/ (C99). The core's malloc and
+# free go to the platform arena (snes/s9x_seattle.c); S9X_MAX_ROM_SIZE sets
+# the ROM buffer. guru.c (fatal-error screen of the exception dispatcher)
+# and sgrab.c (its serial commands) are linked as in the Quake build.
+SNES9X       ?= $(HOME)/snes9x-1.39/release
+SNES_MAX_ROM ?= 0x280000
+ifeq ($(FATFS),1)
+CXX        := $(CROSS)g++
+SNES_CORE  := cpuops cpuexec sa1cpu spc700 soundux apu fxinst fxemu c4 c4emu cpu sa1 sdd1 tile srtc gfx \
+              memmap snaporig clip dsp1 ppu dma snes9x snapshot cheats cheats2 data globals
+SNESDEFS   := -DLSB_FIRST -DVAR_CYCLES -DCPU_SHUTDOWN -DSPC700_SHUTDOWN -DSPC700_C -DEXECUTE_SUPERFX_PER_LINE \
+              -DS9X_MAX_ROM_SIZE=$(SNES_MAX_ROM)
+SNESCXX    := $(ARCHFLAGS) -nostdinc -isystem $(NEWLIB)/include -isystem $(shell $(CC) -print-file-name=include) \
+              -isystem $(shell $(CC) -print-file-name=include-fixed) -I $(SNES9X) -O2 -fno-exceptions -fno-rtti \
+              -fno-strict-aliasing -w -ffunction-sections -fdata-sections $(SNESDEFS) -Dmalloc=s9x_malloc -Dfree=s9x_free
+SNESINC    := -std=gnu99 -isystem $(shell $(CC) -print-file-name=include-fixed) -I snes -I $(SNES9X) -I fatfs $(SNESDEFS)
+SNESOBJS   := $(addprefix $(BUILD)/snes/core/, $(SNES_CORE:=.o)) \
+              $(addprefix $(BUILD)/snes/, s9x_seattle.o menu.o blit.o) $(BUILD)/sys/guru.o $(BUILD)/sys/sgrab.o
+OBJS       += $(SNESOBJS)
+
+$(BUILD)/snes/core/%.o: $(SNES9X)/%.cpp
+	@mkdir -p $(dir $@)
+	$(CXX) $(SNESCXX) -c $< -o $@
+
+$(BUILD)/snes/%.o: snes/%.c
+	@mkdir -p $(dir $@)
+	$(CC) $(CFLAGS) $(SNESINC) -O2 -ffunction-sections -fdata-sections -MMD -MP -c $< -o $@
+
+$(BUILD)/snes/blit.o: snes/blit.S
+	@mkdir -p $(dir $@)
+	$(CC) $(ARCHFLAGS) -c $< -o $@
+endif
+
 all: $(BUILD)/bringup512.u32
 
 rom256: $(BUILD)/bringup.bin
